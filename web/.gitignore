# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright e2e
# tests/.auth holds a real Supabase session token for the E2E user — never commit it.
/tests/.auth/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Local-only E2E harness: seeds real rows via the service-role key and holds a
# test credential. Kept on disk for local runs, deliberately never pushed.
/tests/
/playwright.config.ts
