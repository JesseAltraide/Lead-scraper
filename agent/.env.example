# Agent server (long-running Node process). Never runs in the browser.

SUPABASE_URL=https://REPLACE_ME.supabase.co
# Service role: the agent server writes runs/leads/tool_calls and calls the
# SECURITY DEFINER guard functions.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

ANTHROPIC_API_KEY=REPLACE_ME

# Apify: use the TEAM account token, not your personal one. Runs are billed to
# whichever account they start from.
APIFY_TOKEN=REPLACE_ME
APIFY_ACTOR_ID=REPLACE_ME

FIRECRAWL_API_KEY=REPLACE_ME

# Must match AGENT_SHARED_SECRET in web/.env.local
AGENT_SHARED_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING
PORT=8787
